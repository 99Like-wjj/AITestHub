{
  "name": "aitesthub",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.28.11"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "pnpm build:server && pnpm build:web",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start:api": "node dist/apps/api/src/main.js",
    "db:migrate": "pnpm build:server && node dist/scripts/migrate.js",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"scripts/*.{ts,mjs}\" \"deploy/**/*.{mjs,yaml,json}\" \"tooling/local-client/src/**/*.ts\" \"tooling/local-client/scripts/*.mjs\" package.json tsconfig.server.json tsconfig.tools.json \".github/workflows/*.yml\"",
    "format:docs": "prettier --check AGENTS.md AGENTS.example.md CONTRIBUTING.md SECURITY.md README.md SOURCE_PUBLICATION.md \"docs/development/*.md\" .github/pull_request_template.md .prettierrc.json",
    "quality:check": "pnpm format:check && pnpm format:docs && pnpm typecheck && pnpm quality:client",
    "quality:client": "pnpm --dir tooling/local-client --ignore-workspace typecheck"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@aws-sdk/client-s3": "3.1166.0",
    "@js-temporal/polyfill": "0.5.1",
    "@langchain/anthropic": "1.6.3",
    "@langchain/core": "1.3.7",
    "@langchain/langgraph": "1.7.3",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/langgraph-sdk": "1.15.0",
    "@langchain/openai": "1.8.3",
    "@mermaid-js/tiny": "12.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "antd": "6.7.0",
    "deepagents": "1.16.4",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "js-tiktoken": "1.0.21",
    "langchain": "1.6.4",
    "langsmith": "0.9.0",
    "mysql2": "3.24.6",
    "node-sql-parser": "5.3.13",
    "parse5": "8.1.1",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "reflect-metadata": "0.2.2",
    "remark-gfm": "4.0.1",
    "rxjs": "7.8.2",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
