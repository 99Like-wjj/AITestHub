{
  "schemaVersion": "ath.actions-local-config.v1",
  "repository": "example/aitesthub",
  "dockerExecutable": "/usr/bin/docker",
  "dockerContext": "default",
  "applicationContainers": [
    "example-api",
    "example-api-worker",
    "example-ai-worker"
