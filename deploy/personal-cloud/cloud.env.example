# Names/paths only. Values below are not credentials. Never reuse local runtime.env.
AITESTHUB_PRIVATE_ROOT=/srv/aitesthub-private
AITESTHUB_APP_IMAGE=aitesthub:YOUR_REVIEWED_VERSION
AITESTHUB_POSTGRES_IMAGE=aitesthub-postgres:18.6-fixed
AITESTHUB_SEAWEED_IMAGE=aitesthub-storage:4.53-fixed
# Set from the target runtime account; keep host Ops and application UID aligned.
AITESTHUB_RUN_UID=REQUIRED_TARGET_UID
AITESTHUB_RUN_GID=REQUIRED_TARGET_GID
# Replace with the bucket generated by prepare-private.mjs.
AITESTHUB_S3_BUCKET=REQUIRED_FROM_PRIVATE_PREPARATION
# Phase 1: SSH loopback only. Public HTTPS changes BOTH fields after verification.
AITESTHUB_PUBLIC_ORIGIN=http://localhost:5300
AITESTHUB_COOKIE_SECURE=false
