[Unit]
Description=AITestHub HTTPS trial entry (Caddy 2.11.9)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/aitesthub-caddy
Environment=XDG_CONFIG_HOME=/var/lib/aitesthub-caddy
EnvironmentFile=/srv/aitesthub-private/proxy.env
ExecStart=/usr/local/bin/aitesthub-caddy run --config /srv/aitesthub/deploy/personal-cloud/Caddyfile.ip-shortlived.candidate --adapter caddyfile
ExecReload=/usr/local/bin/aitesthub-caddy reload --config /srv/aitesthub/deploy/personal-cloud/Caddyfile.ip-shortlived.candidate --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=aitesthub-caddy
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
