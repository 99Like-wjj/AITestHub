# Supply an independently verified application image reference containing this release's runtime.
ARG APPLICATION_IMAGE
ARG DOCKER_CLI_IMAGE=docker:29.9.3-cli@sha256:5a7af0dcb0e46c803efe9b45371dd21cb500e5b4453250394ac6f06d49b6e6f1
FROM ${DOCKER_CLI_IMAGE} AS docker_cli
FROM ${APPLICATION_IMAGE}
USER root
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY deploy/local/licenses/docker-cli-LICENSE /usr/local/share/licenses/docker-cli/LICENSE
RUN docker --version && node --version
# Only this authenticated broker has Docker authority; guests and ordinary workers never do.
ENTRYPOINT ["node", "/app/dist/packages/agent-runtime/src/main.js"]
CMD []
