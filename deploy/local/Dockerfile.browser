# APPLICATION_IMAGE must be an already verified application build containing the
# exact playwright runtime dependency and compiled agent-browser packages.
ARG APPLICATION_IMAGE
FROM ${APPLICATION_IMAGE} AS application
FROM mcr.microsoft.com/playwright:v1.65.0-noble@sha256:9beb546099e11f52d62e505537914870e01a67e0e6b00ae41da4775324e73dbe
WORKDIR /app
COPY --from=application /usr/local/bin/node /usr/local/bin/node
COPY --from=application /app/node_modules /app/node_modules
COPY --from=application /app/dist/packages/contracts /app/dist/packages/contracts
COPY --from=application /app/dist/packages/agent-browser /app/dist/packages/agent-browser
COPY --from=application /app/dist/packages/agent-browser-proxy /app/dist/packages/agent-browser-proxy
ENV NODE_ENV=production PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
USER pwuser
CMD ["node","/app/dist/packages/agent-browser/src/main.js"]
