{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/ai-worker/src/**/*.ts",
    "apps/api-worker/src/**/*.ts",
    "packages/**/*.ts",
    "scripts/migrate.ts",
    "scripts/bootstrap-admin.ts",
    "scripts/operations-worker.ts",
    "scripts/prepare-control-key.ts",
    "scripts/checkpoint-model-upgrade.ts",
    "scripts/configure-local-model.ts"
  ],
  "exclude": ["node_modules", "dist", "packages/ui"]
}
